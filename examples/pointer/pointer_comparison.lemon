// pointer_comparison.lemon: equality/inequality of pointer values, including
// aliases of the same local and independent locals.
void main() {
    int x;
    int y;
    int* a;
    int* b;
    int* c;
    x = 3;
    y = 4;
    a = &x;
    b = &x;
    c = &y;
    if (a == b) {
        printf("%d", 1);
    } else {
        printf("%d", 0);
    }
    if (a == c) {
        printf("%d", 1);
    } else {
        printf("%d", 0);
    }
    if (a != c) {
        printf("%d", 1);
    } else {
        printf("%d", 0);
    }
    if (a != null) {
        printf("%d", 1);
    } else {
        printf("%d", 0);
    }
}
