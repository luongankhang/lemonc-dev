pub int add(int a, int b) {
    return a + b;
}

pub int mul(int a, int b) {
    return a * b;
}

pub int fact(int n) {
    int result;
    if (n <= 1) {
        result = 1;
    } else {
        result = mul(n, fact(n - 1));
    }
    return result;
}

pub int sumArray(int arr[], int n) {
    int i;
    int total;
    total = 0;
    for (i = 0; i < n; i = i + 1) {
        total = add(total, arr[i]);
    }
    return total;
}