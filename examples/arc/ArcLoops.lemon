// ARC example demonstrating loop ownership, break, continue, and back-edge balance.
class ArcLoops {
    void main() {
        int i;
        int sum;
        int arr[4];
        i = 0;
        sum = 0;

        while (i < 4) {
            arr[i] = (i + 1) * 10;
            if (i == 2) {
                sum = sum + arr[i];
                i = i + 1;
                continue;
            }
            sum = sum + arr[i];
            i = i + 1;
        }

        for (i = 0; i < 4; i = i + 1) {
            if (arr[i] > 30) {
                break;
            }
            sum = sum + arr[i];
        }

        printf("sum: %d\n", sum);
    }
}
