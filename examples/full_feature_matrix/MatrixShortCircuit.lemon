// MatrixShortCircuit: && and || only evaluate the right operand when needed;
// side-effect functions mark every evaluated operand so output proves it.
int mark(int value, int tag) {
    printf("m%d;", tag);
    return value;
}

void main() {
    int out;
    out = 0;
    // false && ... -> right side skipped.
    if (mark(0, 1) != 0 && mark(1, 2) != 0) {
        out = 1;
    } else {
        out = 0;
    }
    printf(" out=%d\n", out);
    out = 0;
    // true && ... -> right side runs.
    if (mark(1, 3) != 0 && mark(1, 4) != 0) {
        out = 1;
    } else {
        out = 0;
    }
    printf(" out=%d\n", out);
    out = 0;
    // true || ... -> right side skipped.
    if (mark(1, 5) != 0 || mark(1, 6) != 0) {
        out = 1;
    } else {
        out = 0;
    }
    printf(" out=%d\n", out);
    out = 0;
    // false || ... -> right side runs.
    if (mark(0, 7) != 0 || mark(1, 8) != 0) {
        out = 1;
    } else {
        out = 0;
    }
    printf(" out=%d\n", out);
    out = 0;
    // Mixed chain with three operands: false || true && ... with precedence.
    if (mark(0, 9) != 0 || mark(1, 10) != 0 && mark(0, 11) != 0) {
        out = 1;
    } else {
        out = 0;
    }
    printf(" out=%d\n", out);
}
